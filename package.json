{
  "name": "au-tax-trading-ledger",
  "private": true,
  "version": "1.3.1",
  "description": "Local-first Australian tax preparation and multi-market trading record application (offline PWA).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "package": "node scripts/package-zip.mjs"
  },
  "dependencies": {
    "decimal.js": "10.4.3",
    "dexie": "4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "luxon": "3.5.0",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/luxon": "3.4.2",
    "@types/node": "^20.16.11",
    "@types/papaparse": "5.3.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.11.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.4"
  }
}
